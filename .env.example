# Aplicacion
NODE_ENV=development
PORT=3000
TZ=America/La_Paz
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fisio_kine_db
DB_USER=postgres
DB_PASSWORD=
DB_SYNC=false

# JWT / autenticacion
# Use una cadena aleatoria de al menos 32 caracteres fuera de Git.
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Correo SMTP / recuperacion de contrasena
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Physio Active <no-reply@example.invalid>"
FRONTEND_RESET_URL=http://localhost:5173/reset-password
# Enlace profundo que abre la pantalla de recuperacion en la app movil.
MOBILE_RESET_URL=physioactive://reset-password

# Administrador inicial
ADMIN_NAME=Administrador
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=false

# WhatsApp Cloud API
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v24.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Flujo de citas por WhatsApp
WHATSAPP_CONVERSATION_TIMEOUT_MINUTES=30
WHATSAPP_APPOINTMENT_DURATION_MINUTES=90
WHATSAPP_SLOT_INTERVAL_MINUTES=30
WHATSAPP_MAX_AVAILABLE_SLOTS=5
WHATSAPP_SLOT_OPTIONS_TIMEOUT_MINUTES=15
WHATSAPP_AVAILABILITY_SEARCH_DAYS=14
WHATSAPP_MAX_APPOINTMENTS_LIST=5
WHATSAPP_APPOINTMENT_LIST_TIMEOUT_MINUTES=15

# Recordatorios de WhatsApp
WHATSAPP_REMINDERS_ENABLED=false
WHATSAPP_REMINDER_HOURS_BEFORE=24
WHATSAPP_REMINDER_WINDOW_MINUTES=30
WHATSAPP_REMINDER_SCAN_INTERVAL_MINUTES=5
WHATSAPP_REMINDER_MAX_ATTEMPTS=3
WHATSAPP_REMINDER_RETRY_MINUTES=15
WHATSAPP_REMINDER_RESPONSE_TIMEOUT_HOURS=48
WHATSAPP_REMINDER_TEMPLATE_NAME=
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=es

# Respuestas manuales de WhatsApp
WHATSAPP_MANUAL_REPLIES_ENABLED=false
WHATSAPP_MANUAL_REPLY_WINDOW_HOURS=24
WHATSAPP_MANUAL_REPLY_PREVIEW_MINUTES=10
WHATSAPP_MANUAL_REPLY_MAX_ATTEMPTS=3
WHATSAPP_MANUAL_REPLY_RETRY_MINUTES=15

# Notificaciones internas y alertas de derivaciones
INTERNAL_NOTIFICATIONS_ENABLED=true
INTERNAL_NOTIFICATIONS_POLL_SECONDS=15
APPOINTMENT_INTERNAL_REMINDER_SCAN_SECONDS=15
WHATSAPP_REFERRAL_PENDING_ALERT_ENABLED=false
WHATSAPP_REFERRAL_PENDING_ALERT_MINUTES=30
WHATSAPP_REFERRAL_PENDING_ALERT_SCAN_MINUTES=5
WHATSAPP_REFERRAL_PENDING_ALERT_REPEAT_HOURS=4

# Monitoreo de WhatsApp
WHATSAPP_MONITORING_ENABLED=true
WHATSAPP_MONITORING_POLL_SECONDS=60
WHATSAPP_MONITORING_METRICS_DAYS=30
WHATSAPP_MONITORING_EXPORT_MAX_DAYS=90
WHATSAPP_MONITORING_META_CHECK_TIMEOUT_MS=10000
WHATSAPP_MONITORING_RETENTION_DAYS=90

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback
GOOGLE_CALENDAR_ID=primary
# Cadena aleatoria larga y estable; cambiarla invalida los tokens cifrados.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Gemini
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=12000
